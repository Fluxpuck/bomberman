# Multiplayer relay URL — public origin used in production.
# Leave unset for local dev (defaults to ws://localhost:3001).
# NEXT_PUBLIC_WS_URL=wss://your-relay-host

# Discord Activity integration (optional — only used when the game runs
# inside Discord's Activity iframe). Get both from the app's OAuth2 page
# in the Discord Developer Portal.
# NEXT_PUBLIC_DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
